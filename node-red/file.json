    {
        "id": "http_write_func_01",
        "type": "function",
        "z": "828ffb7ced72b6b6",
        "name": "Preparar Escrita OPC-UA",
        "func": "const { nodeId, value, datatype } = msg.payload;\nif (!nodeId) {\n    msg.statusCode = 400;\n    msg.payload = { erro: 'nodeId obrigatorio' };\n    return [null, msg];\n}\nmsg._origPayload = msg.payload;\nif (datatype === 'Boolean') {\n    msg.payload = Boolean(value);\n} else {\n    msg.payload = Number(value);\n    if (isNaN(msg.payload)) {\n        msg.statusCode = 400;\n        msg.payload = { erro: 'valor invalido' };\n        return [null, msg];\n    }\n}\nmsg.topic = nodeId;\nreturn [msg, null];",
        "outputs": 2,
