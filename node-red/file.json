    {
        "id": "d4f3e72f91a0c303",
        "type": "function",
        "z": "828ffb7ced72b6b6",
        "name": "Formatar Temperatura",
        "func": "let raw = msg.payload;\nlet value = null;\nif (raw && typeof raw === 'object') {\n    if (raw.value !== undefined) {\n        if (typeof raw.value === 'object' && raw.value.value !== undefined) {\n            value = raw.value.value;\n        } else {\n            value = raw.value;\n        }\n    } else {\n        msg.payload = { erro: 'Objeto OPC-UA sem campo value', rawPayload: raw };\n        return msg;\n    }\n} else {\n    value = raw;\n}\nif (value === null || value === undefined || isNaN(value)) {\n    msg.payload = { erro: 'Valor invalido', valorRecebido: value };\n    return msg;\n}\nmsg.payload = {\n    tag: 'Temperatura',\n    valor: Number(value).toFixed(2),\n    unidade: '\u00b0C',\n    nodeId: msg.topic,\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
